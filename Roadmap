// services/redis.service.ts
import Redis from 'ioredis';

class RedisService {
  private client: Redis;

  constructor() {
    this.client = new Redis({
      host: process.env.REDIS_HOST,
      port: 6379,
      password: process.env.REDIS_PASSWORD,
      retryStrategy: (times) => Math.min(times * 50, 2000)
    });
  }

  async cacheFile(key: string, data: any, ttl = 3600): Promise {
    await this.client.setex(key, ttl, JSON.stringify(data));
  }

  async getFile(key: string): Promise {
    const data = await this.client.get(key);
    return data ? JSON.parse(data) : null;
  }

  async incrementUploadCount(userId: string): Promise {
    return await this.client.incr(`uploads:${userId}:${Date.now()}`);
  }
}

export const redisService = new RedisService();

