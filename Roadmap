// socket/task.socket.ts
import { Server as SocketServer } from 'socket.io';

export function setupTaskSockets(io: SocketServer) {
  io.use(async (socket, next) => {
    // Authenticate socket connection
    const token = socket.handshake.auth.token;
    try {
      const user = await verifyToken(token);
      socket.data.userId = user.id;
      next();
    } catch (error) {
      next(new Error('Authentication failed'));
    }
  });

  io.on('connection', (socket) => {
    console.log('User connected:', socket.data.userId);

    // Join team rooms
    socket.on('join-team', async (teamId: string) => {
      // Verify user is team member
      const isMember = await verifyTeamMembership(
        socket.data.userId,
        teamId
      );
      
      if (isMember) {
        socket.join(`team:${teamId}`);
        console.log(`User ${socket.data.userId} joined team ${teamId}`);
      }
    });

    // Leave team rooms
    socket.on('leave-team', (teamId: string) => {
      socket.leave(`team:${teamId}`);
    });

    // Typing indicator
    socket.on('typing', ({ taskId, teamId }) => {
      socket.to(`team:${teamId}`).emit('user-typing', {
        taskId,
        userId: socket.data.userId
      });
    });

    socket.on('disconnect', () => {
      console.log('User disconnected:', socket.data.userId);
    });
  });
}

