// services/task.service.ts
import { PrismaClient, Task, Status, Priority } from '@prisma/client';

class TaskService {
  constructor(private prisma: PrismaClient) {}

  async createTask(data: CreateTaskDTO, userId: string): Promise {
    // Verify user is team member
    const membership = await this.prisma.teamMember.findUnique({
      where: {
        userId_teamId: {
          userId,
          teamId: data.teamId
        }
      }
    });
    
    if (!membership) {
      throw new Error('Not a team member');
    }
    
    const task = await this.prisma.task.create({
      data: {
        ...data,
        activities: {
          create: {
            action: 'created',
            userId
          }
        }
      },
      include: {
        assignee: true,
        team: true
      }
    });
    
    // Emit real-time event
    io.to(`team:${data.teamId}`).emit('task:created', task);
    
    // Queue notification email
    await emailQueue.add('task-assigned', {
      taskId: task.id,
      assigneeId: task.assigneeId
    });
    
    return task;
  }

  async updateTask(
    taskId: string, 
    updates: UpdateTaskDTO, 
    userId: string
  ): Promise {
    const task = await this.prisma.task.findUnique({
      where: { id: taskId }
    });
    
    if (!task) throw new Error('Task not found');
    
    // Check permissions
    await this.verifyAccess(userId, task.teamId);
    
    // Track changes for activity log
    const changes: Array = [];
    
    for (const [field, newValue] of Object.entries(updates)) {
      if (task[field] !== newValue) {
        changes.push({
          field,
          old: task[field],
          new: newValue
        });
      }
    }
    
    // Update task
    const updated = await this.prisma.task.update({
      where: { id: taskId },
      data: {
        ...updates,
        activities: {
          create: changes.map(change => ({
            action: 'updated',
            field: change.field,
            oldValue: String(change.old),
            newValue: String(change.new),
            userId
          }))
        }
      },
      include: {
        assignee: true,
        activities: {
          take: 10,
          orderBy: { createdAt: 'desc' }
        }
      }
    });
    
    // Emit real-time update
    io.to(`team:${task.teamId}`).emit('task:updated', updated);
    
    return updated;
  }

  async getTasks(teamId: string, filters: TaskFilters): Promise {
    const where: any = { teamId };
    
    if (filters.status) where.status = filters.status;
    if (filters.priority) where.priority = filters.priority;
    if (filters.assigneeId) where.assigneeId = filters.assigneeId;
    if (filters.search) {
      where.OR = [
        { title: { contains: filters.search, mode: 'insensitive' } },
        { description: { contains: filters.search, mode: 'insensitive' } }
      ];
    }
    
    return await this.prisma.task.findMany({
      where,
      include: {
        assignee: true,
        _count: {
          select: { comments: true }
        }
      },
      orderBy: filters.sortBy || { createdAt: 'desc' },
      take: filters.limit || 50,
      skip: filters.offset || 0
    });
  }
}

